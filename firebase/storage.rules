rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validWebp(maxBytes) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && request.resource.contentType == 'image/webp';
    }

    match /public/profiles/{uid}/avatar.webp {
      allow read: if true;
      allow create, update: if owner(uid) && validWebp(2 * 1024 * 1024);
      allow delete: if owner(uid);
    }

    match /public/thumbnails/{uid}/{streamId}/thumbnail.webp {
      allow read: if true;
      allow create, update: if owner(uid) && validWebp(5 * 1024 * 1024);
      allow delete: if owner(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
