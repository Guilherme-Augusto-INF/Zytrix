{
  "name": "zytrix-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:auth && node scripts/build-policies.mjs && node scripts/build-site.mjs",
    "build:auth": "node scripts/build-auth-client.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "npm run build:auth && node scripts/check.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@neondatabase/auth": "0.5.0-beta",
    "@vercel/blob": "2.8.1",
    "better-auth": "1.6.23",
    "nodemailer": "10.1.7",
    "pg": "8.23.0",
    "sharp": "0.35.5",
    "stripe": "22.6.2",
    "@better-auth/kysely-adapter": "1.6.23",
    "kysely": "0.29.6"
  },
  "engines": {
    "node": ">=22"
  }
}
